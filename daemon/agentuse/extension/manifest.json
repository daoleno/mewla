{
  "manifest_version": 3,
  "name": "Mewla",
  "short_name": "Mewla",
  "version": "0.1.0",
  "description": "Lets the agents Mewla starts on this computer work in Chrome, in a window of their own, with your logged-in sites. Nothing leaves this computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mewla",
    "default_popup": "status.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
