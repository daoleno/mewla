FROM golang:1.25-alpine AS build
WORKDIR /src
COPY daemon/go.mod daemon/go.sum ./
RUN go mod download
COPY daemon/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mewla-account ./cmd/mewla-account
RUN mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mewla-account /usr/local/bin/mewla-account
COPY --from=build --chown=nonroot:nonroot /out/data /var/lib/mewla-account
USER nonroot:nonroot
WORKDIR /var/lib/mewla-account
VOLUME ["/var/lib/mewla-account"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mewla-account"]
