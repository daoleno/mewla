# Hosted remote access image: the relay and the account service, deployed
# together by config/deploy.yml. Each container picks its binary in `cmd`.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY daemon/go.mod daemon/go.sum ./
RUN go mod download
COPY daemon/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mewla-relay ./cmd/mewla-relay && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mewla-account ./cmd/mewla-account
RUN mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mewla-relay /out/mewla-account /usr/local/bin/
COPY --from=build --chown=nonroot:nonroot /out/data /var/lib/mewla-account
USER nonroot:nonroot
WORKDIR /var/lib/mewla-account
# Both binaries serve /healthz on :8080 inside their container (the relay's
# operator listener, the account service's API).
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/mewla-account", "-check=http://127.0.0.1:8080/healthz"]
