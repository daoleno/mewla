{
  "name": "mewla",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "site:dev": "bun site/index.html",
    "daemon:build": "./scripts/build-mewla-local.sh bin/mewla",
    "web:build": "./scripts/build-web-ui.sh",
    "daemon:build:linux": "./scripts/build-daemon-linux.sh",
    "daemon:test": "cd daemon && go test ./...",
    "installer:test": "./scripts/tests/install_test.sh",
    "release:identity": "./scripts/verify-release-identity.sh",
    "release:stage": "./scripts/stage-release.sh",
    "native:contract": "./scripts/verify-libghostty.sh --contract",
    "native:verify": "./scripts/verify-libghostty.sh",
    "native:verify:release": "./scripts/verify-libghostty.sh --release",
    "native:build": "./scripts/build-libghostty.sh",
    "native:build:ios": "./scripts/build-libghostty-ios.sh",
    "native:verify:ios": "./scripts/verify-libghostty-ios.sh",
    "screen:generate": "bun client/ui/more/screen/runtime/generate.mjs",
    "licenses:generate": "python3 client/ui/more/settings/licenses/generate.py",
    "ios:verify-artifact": "./scripts/verify-ios-artifact.sh",
    "android:release-apk": "./scripts/android-release-apk.sh",
    "android:verify-apk-notice": "./scripts/verify-apk-notice.sh",
    "android:verify-apk-release": "./scripts/verify-apk-release.sh"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0"
  }
}
