# Copy to .kamal/secrets (gitignored). Kamal expands $(command) when it loads
# secrets, so the token stays in its own 0600 file and never in this one.
MEWLA_ACCOUNT_CLOUDFLARE_TOKEN=$(tr -d '[:space:]' < ~/.config/mewla-remote/cloudflare-dns-token)
# The Google client secret comes from the JSON the Google console downloads;
# the receipt key is 32 random bytes, base64url without padding.
MEWLA_ACCOUNT_GOOGLE_CLIENT_SECRET=$(jq -er '.web.client_secret | select(type == "string" and length > 0)' ~/.config/mewla-remote/google-oauth-client.json)
MEWLA_ACCOUNT_GOOGLE_RECEIPT_KEY=$(tr -d '[:space:]' < ~/.config/mewla-remote/google-receipt-key)
