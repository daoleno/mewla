# Copy to .kamal/secrets (gitignored). Kamal expands $(command) when it loads
# secrets, so the token stays in its own 0600 file and never in this one.
MEWLA_ACCOUNT_CLOUDFLARE_TOKEN=$(tr -d '[:space:]' < ~/.config/mewla-remote/cloudflare-dns-token)
MEWLA_ACCOUNT_MEDIA_ACCESS_KEY=$(tr -d '[:space:]' < ~/.config/mewla-remote/friends-media-access-key)
MEWLA_ACCOUNT_MEDIA_SECRET_KEY=$(tr -d '[:space:]' < ~/.config/mewla-remote/friends-media-secret-key)
