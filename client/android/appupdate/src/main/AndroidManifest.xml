<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app update's permission and FileProvider; merged into the app only on the GitHub channel,
     so the Play build never asks to install other packages. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

  <!-- The app this one replaces (the build's legacyAppId: com.daoleno.mewla, with .preview / .debug as this variant has
       them) stages what pairs the phone for this app to take once, and is removed when the person says (Handover.kt). -->
  <uses-permission android:name="${legacyAppId}.permission.HANDOVER" />
  <queries>
    <package android:name="${legacyAppId}" />
    <provider android:authorities="${legacyAppId}.handover" />
  </queries>

  <!-- The move to another app (Handover.kt): only an app of the same release key can ask the old one for what pairs this phone. -->
  <permission android:name="${applicationId}.permission.HANDOVER" android:protectionLevel="signature" />

  <application>
    <meta-data android:name="com.daoleno.mewla.appupdate.VAULT" android:value="com.daoleno.mewla.update.AppHandoverVault" />
    <provider
      android:name="com.daoleno.mewla.appupdate.HandoverProvider"
      android:authorities="${applicationId}.handover"
      android:exported="true"
      android:permission="${applicationId}.permission.HANDOVER" />

    <provider
      android:name="com.daoleno.mewla.appupdate.AppUpdateFileProvider"
      android:authorities="${applicationId}.appupdate"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/mewla_app_update_paths" />
    </provider>
  </application>
</manifest>
