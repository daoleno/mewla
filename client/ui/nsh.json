{
  "name": "Mewla",
  "id": "com.daoleno.mewla",
  "version": "0.3.0",
  "build": 1,
  "appearance": "system",
  "capabilities": {
    "host": [
      "app.*",
      "secure.*",
      "links.*",
      "link.*",
      "scan.*",
      "push.*",
      "terminal.*",
      "calendar.*",
      "live.*",
      "files.*",
      "phone.*",
      "update.*",
      "web.*"
    ],
    "network": {
      "hosts": [
        "*"
      ]
    },
    "openUrl": true,
    "clipboard": true,
    "webview": {
      "hosts": [
        "viewer.mewla.invalid"
      ]
    }
  },
  "theme": "./theme.json",
  "web": {
    "host": "web/host.js"
  }
}
