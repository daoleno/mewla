{
  "display_information": { "name": "Mewla", "description": "Connect your workspace to your private Mewla server" },
  "oauth_config": {
    "redirect_urls": ["https://connect.mewla.ai/plugins/return", "mewla://plugins"],
    "scopes": { "user": ["channels:read", "channels:history", "groups:read", "groups:history", "im:read", "im:history", "mpim:read", "mpim:history", "search:read", "files:read", "chat:write", "files:write"] },
    "pkce_enabled": true
  },
  "settings": { "org_deploy_enabled": false, "socket_mode_enabled": false, "token_rotation_enabled": true }
}
