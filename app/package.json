{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:debug": "expo run:android --variant debug",
    "android:release": "expo run:android --variant release",
    "build:apk": "cd android && env NODE_ENV=production ./gradlew --no-daemon --build-cache assembleRelease -PreactNativeArchitectures=arm64-v8a -Pexpo.useLegacyPackaging=true && ln -f app/build/outputs/apk/release/app-release.apk app/build/outputs/apk/release/app-release-arm64.apk && echo '\n✅ APK: android/app/build/outputs/apk/release/app-release-arm64.apk'",
    "build:apk:arm64": "bun run build:apk",
    "build:aab": "cd android && env NODE_ENV=production ./gradlew --no-daemon --build-cache bundleRelease -PreactNativeArchitectures=arm64-v8a && echo '\n✅ AAB: android/app/build/outputs/bundle/release/app-release.aab'",
    "build:apk:universal": "cd android && ./gradlew --no-daemon assembleRelease && echo '\n✅ APK: android/app/build/outputs/apk/release/app-release.apk'",
    "build:apk:debug": "sh -c 'bunx expo prebuild --platform android --no-install --no-clean && cd android && ./gradlew --no-daemon assembleDebug -PreactNativeArchitectures=arm64-v8a -PmewlaStandalone=false && cp -f app/build/outputs/apk/debug/app-debug.apk app/build/outputs/apk/debug/mewla-debug-arm64.apk && sha256sum app/build/outputs/apk/debug/mewla-debug-arm64.apk && echo APK: android/app/build/outputs/apk/debug/mewla-debug-arm64.apk'",
    "serve:apk": "cd android/app/build/outputs/apk/release && python3 -m http.server 8899",
    "serve:apk:arm64": "cd android/app/build/outputs/apk/release && python3 -m http.server 8899",
    "serve:apk:debug": "cd android/app/build/outputs/apk/debug && python3 -m http.server 8899"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/config-plugins": "~58.0.0",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@lobehub/icons-rn": "^2.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/virtualized-lists": "0.88.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "base64-js": "1.5.1",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-modules-core": "~58.0.28",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "marked": "18.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-drawer-layout": "4.2.12",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-pdf-renderer": "2.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "4.3.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "remend": "1.4.0",
    "sax": "1.6.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "mermaid": "12.2.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "typescript"
      ]
    }
  },
  "private": true,
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": false,
    "enableVideo": false
  }
}
