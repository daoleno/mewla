{
  "expo": {
    "name": "Mewla",
    "slug": "mewla",
    "version": "0.2.3",
    "orientation": "portrait",
    "icon": "./assets/branding/mewla-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mewla",
    "ios": {
      "bundleIdentifier": "com.daoleno.mewla",
      "icon": {
        "light": "./assets/branding/mewla-icon.png",
        "dark": "./assets/branding/mewla-icon-dark.png",
        "tinted": "./assets/branding/mewla-icon-tinted.png"
      },
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocalNetworkUsageDescription": "Allow Mewla to connect to your self-hosted daemon on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8",
        "foregroundImage": "./assets/branding/mewla-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/mewla-adaptive-monochrome.png"
      },
      "package": "com.daoleno.mewla",
      "versionCode": 43,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/branding/mewla-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/mewla-splash.png",
          "imageWidth": 128,
          "backgroundColor": "#FBFAF7",
          "dark": {
            "image": "./assets/branding/mewla-splash.png",
            "backgroundColor": "#141210"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan Mewla pairing QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {}
    },
    "owner": "getzen"
  }
}
