# Binaries
/bin/
daemon/bin/
daemon/tmp/

# Dependencies (no trailing slash: worktrees link node_modules as a symlink)
node_modules
dist-download/
coverage/

# Local build artifacts
*.apk
*.aab
*.ipa
*.log
*.tmp
*.temp
/tmp/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
.env.local
!.env.example
!.env.*.example

# Host CMake/JVM bridge test build (never shipped)
/build/

# Bun
bun.lockb

# Daemon binary
/daemon/mewla-daemon

# Playwright and local UI captures
.playwright-mcp/
test-results/

# Local Mewla workspace state
.mewla/
/inbox/

# Kamal secrets and the relay's key, certificate and grant key list
.kamal/secrets
.kamal/secrets-common
.kamal/files/

# Caches
.cache/
.turbo/
.next/
__pycache__/
*.py[cod]

# libghostty-vt for the client's terminal (scripts/build-libghostty*.sh outputs;
# native.lock.json and NOTICE.Ghostty stay tracked)
/native/terminal-vt/libs/
/native/terminal-vt/include/

# Daemon-embedded web UI (generated by scripts/build-web-ui.sh)
daemon/webui/dist/*
!daemon/webui/dist/.gitkeep

# Local QA and crash captures (scripts/capture-android-crash.sh)
/artifacts/

# go build in daemon/cmd/mewla drops the binary here
/daemon/cmd/mewla/mewla
# go build ./cmd/mewla in daemon/ drops the binary here
/daemon/mewla

# Session host terminal engine: static libghostty-vt built by
# scripts/build-libghostty-desktop.sh. mewla-dev builds with the ghosttyvt tag
# whenever this directory exists.
/daemon/ghostty-libs/
/daemon/.ghostty-libs.*
